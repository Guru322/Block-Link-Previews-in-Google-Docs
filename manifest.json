{
  "manifest_version": 3,
  "name": "Disable Link Preview in Google Docs",
  "version": "1.0",
  "description": "An extension to block the link preview pop-up in Google Docs.",
  "permissions": ["scripting", "storage"],
  "host_permissions": ["https://docs.google.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}

